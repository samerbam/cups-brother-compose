CUPS_ADMIN_USER=admin
CUPS_PASSWORD=replace-with-a-strong-password
TIMEZONE=Etc/UTC
# Leave empty to skip installation of a Brother driver.
CUPS_BR_PRINTER=
CONFIG_PATH=./config
CUPS_BIND_ADDRESS=0.0.0.0
CUPS_PORT=631
CUPS_USB_PATH=/dev/bus/usb
CUPS_CONTAINER_NAME=cups
CUPS_RESTART_POLICY=unless-stopped
